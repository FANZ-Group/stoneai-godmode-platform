# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.mov binary
*.webm binary

# Lockfiles (keep as-is)
package-lock.json -text
pnpm-lock.yaml -text
yarn.lock -text
Cargo.lock -text
poetry.lock -text
